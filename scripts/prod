#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="${PROD_ENV_FILE:-$REPO_ROOT/.env}"
TELEGRAM_BOOTSTRAP_ENV_FILE="${PROD_TELEGRAM_BOOTSTRAP_ENV_FILE:-$REPO_ROOT/.env.telegram-bootstrap}"
SEED_DIR="${PROD_SEED_DIR:-$REPO_ROOT/data/seeds/production}"

use_seed=0
reset_requested=0
check_only=0
recency_days="90"
seed_artifact=""
selected_seed_artifact=""

usage() {
    cat >&2 <<'EOF'
usage: scripts/prod [--check] [--seed [--seed-artifact PATH]] [--reset [--seed-artifact PATH]] [--recency DAYS]

Boot the production-shaped local stack with the explicit prod compose chain.

The script:
  1. validates .env inputs
  2. validates the prod compose chain
  3. optionally resets compose volumes when --reset is passed
  4. starts db and migrate in order
  5. optionally imports a fresh-only production seed
  6. bootstraps the runtime Telegram credential when the bot token is present
  7. starts the runtime services and waits for readiness

--reset is destructive: it removes compose volumes, then imports the selected
production seed into the fresh stack.

--recency defaults to 90 days and overrides daemon ingestion recency filtering.

Override the env file or default seed directory for testing with:
  PROD_ENV_FILE=/path/to/.env scripts/prod --check
  PROD_ENV_FILE=/path/to/.env scripts/prod
  PROD_TELEGRAM_BOOTSTRAP_ENV_FILE=/path/to/.env.telegram-bootstrap scripts/prod
  PROD_SEED_DIR=/path/to/seeds scripts/prod --seed
EOF
}

parse_args() {
    while (( "$#" > 0 )); do
        case "$1" in
            --check)
                check_only=1
                shift
                ;;
            --seed)
                use_seed=1
                shift
                ;;
            --reset)
                reset_requested=1
                use_seed=1
                shift
                ;;
            --seed-artifact)
                if (( "$#" < 2 )); then
                    echo "error: --seed-artifact requires a path" >&2
                    usage
                    exit 2
                fi
                seed_artifact="$2"
                shift 2
                ;;
            --recency)
                shift
                if (( "$#" == 0 )) || ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
                    echo "error: --recency requires a positive integer day count" >&2
                    usage
                    exit 2
                fi
                recency_days="$1"
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                echo "error: unknown argument: $1" >&2
                usage
                exit 2
                ;;
        esac
    done

    if (( use_seed == 0 )) && [[ -n "$seed_artifact" ]]; then
        echo "error: --seed-artifact requires --seed or --reset" >&2
        usage
        exit 2
    fi
}

configure_runtime_env() {
    export ENDPOINT_DAEMON__INGESTION_CONTROLS__RECENCY_DAYS="$recency_days"
    export TELEGRAM_BOOTSTRAP_ENV_FILE="$TELEGRAM_BOOTSTRAP_ENV_FILE"
}

require_command() {
    local command_name="$1"
    local install_hint="$2"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "error: $command_name is required" >&2
        echo "       $install_hint" >&2
        exit 2
    fi
}

load_env() {
    if [[ ! -f "$ENV_FILE" ]]; then
        echo "error: env file not found: $ENV_FILE" >&2
        exit 2
    fi

    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a

    if [[ -z "${PRESENTATION_API_SECRET_KEY:-}" && -n "${SECRET_KEY:-}" ]]; then
        export PRESENTATION_API_SECRET_KEY="$SECRET_KEY"
        echo "[prod] PRESENTATION_API_SECRET_KEY not set in $ENV_FILE; using SECRET_KEY for this run"
    fi

    required_vars=(
        POSTGRES_DB
        POSTGRES_USER
        POSTGRES_PASSWORD
        ENDPOINT_FERNET_KEY
        ENDPOINT_ADMIN_PASSWORD
        ENDPOINT_SESSION_SECRET
        ENDPOINT_HEADLESS__INTERNAL_SECRET
        PRESENTATION_API_SECRET_KEY
    )

    missing_vars=()
    for var_name in "${required_vars[@]}"; do
        if [[ -z "${!var_name:-}" ]]; then
            missing_vars+=("$var_name")
        fi
    done

    if (( ${#missing_vars[@]} > 0 )); then
        printf 'error: missing required env vars in %s: %s\n' \
            "$ENV_FILE" "${missing_vars[*]}" >&2
        exit 2
    fi
}

compose() {
    docker compose \
        --env-file "$ENV_FILE" \
        -f "$REPO_ROOT/docker-compose.yml" \
        -f "$REPO_ROOT/docker-compose.prod.yml" \
        --profile prod \
        "$@"
}

compose_with_profile() {
    local extra_profile="$1"
    shift

    docker compose \
        --env-file "$ENV_FILE" \
        -f "$REPO_ROOT/docker-compose.yml" \
        -f "$REPO_ROOT/docker-compose.prod.yml" \
        --profile prod \
        --profile "$extra_profile" \
        "$@"
}

env_file_has_nonempty_var() {
    local file="$1"
    local var_name="$2"
    local line=""
    local value=""

    [[ -f "$file" ]] || return 1

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        if [[ "$line" =~ ^[[:space:]]*${var_name}[[:space:]]*= ]]; then
            value="${line#*=}"
            value="${value%%#*}"
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"
            value="${value%\"}"
            value="${value#\"}"
            value="${value%\'}"
            value="${value#\'}"
            [[ -n "$value" ]] && return 0
        fi
    done < "$file"

    return 1
}

validate_telegram_env_boundary() {
    if env_file_has_nonempty_var "$ENV_FILE" "ENDPOINT_TELEGRAM__BOT_TOKEN"; then
        {
            echo "[prod] ERROR: ENDPOINT_TELEGRAM__BOT_TOKEN is set in the shared .env runtime scope"
            echo "[prod] URGENT: move it to $TELEGRAM_BOOTSTRAP_ENV_FILE so only bootstrap-telegram-credential receives it"
            echo "[prod] ERROR: refusing startup because compose env_file would inject the token into daemon"
        } >&2
        exit 2
    fi
}

validate_compose() {
    require_command docker "Install Docker and make sure the daemon is running."

    if ! docker compose --env-file "$ENV_FILE" version >/dev/null 2>&1; then
        echo "error: docker compose is unavailable or Docker is not running" >&2
        exit 2
    fi

    compose config --quiet
}

wait_for_health() {
    local service="$1"
    local timeout_seconds="$2"
    local cid=""
    local status=""
    local elapsed=0

    echo -n "[prod] waiting for $service to become healthy"

    while (( elapsed < timeout_seconds )); do
        cid="$(compose ps -q "$service" 2>/dev/null || true)"
        if [[ -n "$cid" ]]; then
            status="$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null || true)"
            if [[ "$status" == "healthy" ]]; then
                echo " ✓"
                return 0
            fi
        fi
        echo -n "."
        sleep 2
        elapsed=$((elapsed + 2))
    done

    echo
    echo "error: $service did not become healthy within ${timeout_seconds}s" >&2
    compose ps "$service" >&2 || true
    return 1
}

wait_for_running() {
    local service="$1"
    local timeout_seconds="$2"
    local cid=""
    local status=""
    local elapsed=0

    echo -n "[prod] waiting for $service to be running"

    while (( elapsed < timeout_seconds )); do
        cid="$(compose ps -q "$service" 2>/dev/null || true)"
        if [[ -n "$cid" ]]; then
            status="$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null || true)"
            if [[ "$status" == "running" ]]; then
                echo " ✓"
                return 0
            fi
        fi
        echo -n "."
        sleep 2
        elapsed=$((elapsed + 2))
    done

    echo
    echo "error: $service did not reach running state within ${timeout_seconds}s" >&2
    compose ps "$service" >&2 || true
    return 1
}

wait_for_successful_exit() {
    local service="$1"
    local timeout_seconds="$2"
    local cid=""
    local status=""
    local exit_code=""
    local elapsed=0

    echo -n "[prod] waiting for $service to finish"

    while (( elapsed < timeout_seconds )); do
        cid="$(compose ps -aq "$service" 2>/dev/null || true)"
        if [[ -n "$cid" ]]; then
            status="$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null || true)"
            exit_code="$(docker inspect -f '{{.State.ExitCode}}' "$cid" 2>/dev/null || true)"
            if [[ "$status" == "exited" && "$exit_code" == "0" ]]; then
                echo " ✓"
                return 0
            fi
        fi
        echo -n "."
        sleep 2
        elapsed=$((elapsed + 2))
    done

    echo
    echo "error: $service did not complete successfully within ${timeout_seconds}s" >&2
    compose ps "$service" >&2 || true
    return 1
}

resolve_seed_artifact() {
    if (( use_seed == 0 )); then
        return 0
    fi

    if [[ -n "$seed_artifact" ]]; then
        if [[ ! -f "$seed_artifact" ]]; then
            echo "error: seed artifact not found: $seed_artifact" >&2
            exit 1
        fi
        selected_seed_artifact="$(cd "$(dirname "$seed_artifact")" && pwd -P)/$(basename "$seed_artifact")"
        return 0
    fi

    if [[ -d "$SEED_DIR" ]]; then
        selected_seed_artifact="$(find "$SEED_DIR" -maxdepth 1 -type f -name '*.json.gz' | sort | tail -n 1)"
    else
        selected_seed_artifact=""
    fi

    if [[ -z "$selected_seed_artifact" ]]; then
        echo "error: no production seed artifacts found under $SEED_DIR" >&2
        exit 1
    fi
}

start_runtime_services() {
    compose up -d daemon processor headless presentation-api frontend dashboard
    wait_for_running processor 60
    wait_for_health headless 90
    wait_for_health presentation-api 90
    wait_for_health daemon 120
    wait_for_health frontend 120
    wait_for_health dashboard 90
}

reset_stack() {
    echo "[prod] resetting prod-shaped compose volumes..."
    compose down -v --remove-orphans
}

run_seed_import() {
    local artifact_dir=""
    local artifact_name=""
    local seed_dir_real=""
    local output=""

    artifact_dir="$(cd "$(dirname "$selected_seed_artifact")" && pwd -P)"
    artifact_name="$(basename "$selected_seed_artifact")"

    if [[ -d "$SEED_DIR" ]]; then
        seed_dir_real="$(cd "$SEED_DIR" && pwd -P)"
    fi

    echo "[prod] importing production seed: $selected_seed_artifact"

    if [[ -n "$seed_dir_real" && "$artifact_dir" == "$seed_dir_real" ]]; then
        if ! output="$(
            compose_with_profile seed-import run --rm --no-deps \
                -e "SEED_ARTIFACT=/seeds/$artifact_name" \
                import-production-seed 2>&1
        )"; then
            printf '%s\n' "$output" >&2
            if [[ "$output" == *"fresh-only import requires empty table"* ]]; then
                echo "error: production seed import refused because the target Postgres or daemon state is not empty" >&2
            else
                echo "error: production seed import failed" >&2
            fi
            exit 1
        fi
    else
        if ! output="$(
            compose_with_profile seed-import run --rm --no-deps \
                -v "$artifact_dir:/seed-override:ro" \
                -e "SEED_ARTIFACT=/seed-override/$artifact_name" \
                import-production-seed 2>&1
        )"; then
            printf '%s\n' "$output" >&2
            if [[ "$output" == *"fresh-only import requires empty table"* ]]; then
                echo "error: production seed import refused because the target Postgres or daemon state is not empty" >&2
            else
                echo "error: production seed import failed" >&2
            fi
            exit 1
        fi
    fi

    printf '%s\n' "$output"
}

run_telegram_credential_bootstrap() {
    local output=""

    echo "[prod] bootstrapping Telegram credential from ENDPOINT_TELEGRAM__BOT_TOKEN..."
    if ! output="$(compose_with_profile telegram-bootstrap run --rm --no-deps bootstrap-telegram-credential 2>&1)"; then
        printf '%s\n' "$output" >&2
        echo "error: Telegram credential bootstrap failed" >&2
        exit 1
    fi

    printf '%s\n' "$output"
}

ensure_runtime_telegram_credential() {
    if env_file_has_nonempty_var "$TELEGRAM_BOOTSTRAP_ENV_FILE" "ENDPOINT_TELEGRAM__BOT_TOKEN"; then
        run_telegram_credential_bootstrap
        return 0
    fi

    if [[ ! -f "$TELEGRAM_BOOTSTRAP_ENV_FILE" ]]; then
        {
            echo "[prod] URGENT: Telegram bootstrap env file is missing: $TELEGRAM_BOOTSTRAP_ENV_FILE"
            echo "[prod] URGENT: live Telegram polling will not be bootstrapped for this runtime"
        } >&2
        return 0
    fi

    {
        echo "[prod] URGENT: ENDPOINT_TELEGRAM__BOT_TOKEN is not set in $TELEGRAM_BOOTSTRAP_ENV_FILE"
        echo "[prod] URGENT: live Telegram polling will not be bootstrapped for this runtime"
    } >&2
}

print_summary() {
    cat <<EOF
[prod] stack ready
[prod] frontend:         http://localhost:3000
[prod] presentation-api: http://localhost:8001
[prod] headless:         http://localhost:8000
[prod] dashboard:        http://localhost:4173
EOF

    if (( use_seed == 1 )); then
        printf '[prod] seed artifact: %s\n' "$selected_seed_artifact"
    fi
}

main() {
    parse_args "$@"
    load_env
    configure_runtime_env
    validate_telegram_env_boundary
    resolve_seed_artifact

    cd "$REPO_ROOT"
    validate_compose

    if (( check_only == 1 )); then
        echo "[prod] check OK"
        return 0
    fi

    if (( reset_requested == 1 )); then
        reset_stack
    fi

    echo "[prod] starting db..."
    compose up -d db
    wait_for_health db 60

    echo "[prod] starting migrate..."
    compose up -d migrate
    wait_for_successful_exit migrate 120

    echo "[prod] starting presentation-api migrations..."
    compose up -d migrate-presentation-api
    wait_for_successful_exit migrate-presentation-api 120

    if (( use_seed == 1 )); then
        run_seed_import
    fi

    ensure_runtime_telegram_credential

    echo "[prod] starting runtime services..."
    start_runtime_services
    print_summary
}

main "$@"
