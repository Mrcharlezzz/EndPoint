# =============================================================================
# Endpoint .env.example
# =============================================================================
# Copy to .env, fill the REQUIRED block, leave the Optional blocks at their
# defaults unless you know what you're tuning. Compose validates required-
# value enforcement via ${VAR:?msg} syntax — an empty REQUIRED value will
# fail `docker compose up` rather than silently boot with weak defaults.
#
# Variables prefixed ENDPOINT_DAEMON__ are read by pydantic-settings (see
# src/ingestion/ingestion/daemon/config.py). The double-underscore is a
# nesting delimiter: ENDPOINT_DAEMON__SCHEDULER__TICK_SECONDS sets
# DaemonConfig.scheduler.tick_seconds.
# =============================================================================


# =============================================================================
# REQUIRED — boot-time secrets and infra connectivity
# =============================================================================

# Postgres credentials. PG_HOST=localhost is for host-side tools (psql, pytest).
# The compose stack overrides PG_HOST=db for every service that needs the DB.
POSTGRES_DB=shared_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432

# Fernet key used to encrypt PlatformCredential rows. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, comma-separate: new_key,old_key (new_key goes first).
ENDPOINT_FERNET_KEY=

# Admin dashboard login. The daemon refuses to boot with a value shorter
# than 16 chars or one of the obviously-weak placeholders. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENDPOINT_ADMIN_PASSWORD=

# Signing secret for the session cookie. Any high-entropy string; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENDPOINT_SESSION_SECRET=

# Shared secret between the headless auth service and the presentation-api.
# The headless service exposes /internal/auth/teams/{id}/payload guarded by
# this secret (X-Internal-Secret header), and the presentation-api uses it
# to fetch captured Teams credentials server-to-server. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENDPOINT_HEADLESS__INTERNAL_SECRET=

# Django SECRET_KEY for the presentation-api. Cannot be rotated without
# invalidating every existing session and CSRF token. Generate ONCE at
# deploy time and store securely (vault / sealed secret). Values
# containing "django-insecure", "change-me", "default", "example", or
# shorter than 50 chars are rejected at Django startup. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
PRESENTATION_API_SECRET_KEY=


# =============================================================================
# REQUIRED — service-to-service URLs (defaults work for compose)
# =============================================================================

# How the presentation-api reaches the headless service over the compose
# network. Defaults to the in-network hostname; override only if running
# the two services in different networks.
HEADLESS_INTERNAL_URL=http://headless:8000

# How the Next.js frontend reaches the headless service for the public
# REST + WebSocket reverse-proxy rewrites. In compose this is the
# in-network hostname; for host-side `npm run dev` use http://localhost:8000.
HEADLESS_PUBLIC_URL=http://headless:8000


# =============================================================================
# Optional — daemon top-level (DaemonConfig)
# =============================================================================

# Daemon log verbosity (DEBUG, INFO, WARNING, ERROR).
ENDPOINT_DAEMON__LOG_LEVEL=INFO

# Path to the SQLite state store. The Dockerfile pins this to
# /var/lib/ingestor/state.db and chowns the directory to the non-root
# ingestor user; only override outside the container.
# ENDPOINT_DAEMON__SQLITE_PATH=/var/lib/ingestor/state.db


# =============================================================================
# Optional — daemon scheduler (DaemonConfig.scheduler)
# =============================================================================

# Master switch for the scheduler loop. False boots the daemon with API +
# observability only, no syncs. Useful for sandbox runs.
ENDPOINT_DAEMON__SCHEDULER__ENABLED=true

# Pause every user globally. Toggled live via the dashboard; flipping
# this in env makes it the default at every reboot.
ENDPOINT_DAEMON__SCHEDULER__GLOBAL_PAUSED=false

# Drain mode: finish in-flight syncs but admit no new ones. Used during
# rolling restarts so SIGTERM still cleans up cleanly.
ENDPOINT_DAEMON__SCHEDULER__DRAIN_MODE=false

# Scheduler tick interval (seconds). Lower = tighter scheduling but more
# SQLite reads. 1.0 is the project default.
ENDPOINT_DAEMON__SCHEDULER__TICK_SECONDS=1.0

# Max concurrent syncs across the entire pool.
ENDPOINT_DAEMON__SCHEDULER__MAX_CONCURRENT_SYNCS=8

# Max concurrent syncs PER USER (across all platforms). 0 = admit nothing.
ENDPOINT_DAEMON__SCHEDULER__MAX_SYNCS_PER_USER=2

# Default per-platform sync interval (seconds). Per-user overrides live
# in the user_schedule_overrides SQLite table.
ENDPOINT_DAEMON__SCHEDULER__DEFAULT_INTERVAL_SECONDS=600

# After N consecutive failures the scheduler stops scheduling that
# (user, platform) for dead_letter_cooldown_seconds.
ENDPOINT_DAEMON__SCHEDULER__DEAD_LETTER_THRESHOLD=3
ENDPOINT_DAEMON__SCHEDULER__DEAD_LETTER_COOLDOWN_SECONDS=3600


# =============================================================================
# Optional — daemon platform toggles (DaemonConfig.platforms)
# =============================================================================

# Hard enable/disable per platform. Disabled platforms drop forced syncs.
ENDPOINT_DAEMON__PLATFORMS__TEAMS_ENABLED=true
ENDPOINT_DAEMON__PLATFORMS__MOODLE_ENABLED=true
ENDPOINT_DAEMON__PLATFORMS__TELEGRAM_ENABLED=true

# Transient operator pause per platform. Honoured every tick; flip via
# `PUT /v1/config/overlay/platforms.paused.<platform>` for live toggles.
ENDPOINT_DAEMON__PLATFORMS__PAUSED__TEAMS=false
ENDPOINT_DAEMON__PLATFORMS__PAUSED__MOODLE=false
ENDPOINT_DAEMON__PLATFORMS__PAUSED__TELEGRAM=false


# =============================================================================
# Optional — daemon Teams refresh (DaemonConfig.teams_refresh)
# =============================================================================

# Master switch for the bulk Teams token-refresh loop. Set to false on
# deployments that don't ship Playwright Chromium (the daemon image in
# this repo does — slice 14 part A — so the default `true` is fine).
ENDPOINT_DAEMON__TEAMS_REFRESH__ENABLED=true
ENDPOINT_DAEMON__TEAMS_REFRESH__INTERVAL_SECONDS=1800
ENDPOINT_DAEMON__TEAMS_REFRESH__POOL_SIZE=4
ENDPOINT_DAEMON__TEAMS_REFRESH__POOL_JITTER_SECONDS=1.0
ENDPOINT_DAEMON__TEAMS_REFRESH__TIMEOUT_SECONDS=30
ENDPOINT_DAEMON__TEAMS_REFRESH__MAX_RETRIES_PER_USER=1
ENDPOINT_DAEMON__TEAMS_REFRESH__CONCURRENCY=8


# =============================================================================
# Optional — daemon API server (DaemonConfig.api)
# =============================================================================

# Hard disable the API server (the FastAPI app still builds for tests).
ENDPOINT_DAEMON__API__ENABLED=true

# Bind host. 0.0.0.0 inside the container; override only when binding
# to a specific interface on the host.
ENDPOINT_DAEMON__API__HOST=0.0.0.0
ENDPOINT_DAEMON__API__PORT=8765

# Admin session lifetime (hours).
ENDPOINT_DAEMON__API__SESSION_TTL_HOURS=24

# CORS origins (comma list). Empty = same-origin only. A bare `*` is
# rejected at startup since browsers refuse it with credentials.
# ENDPOINT_DAEMON__API__CORS_ORIGINS=

# Set to true once a TLS-terminating proxy sits in front of the daemon
# so the session cookie is issued with Secure=true.
ENDPOINT_DAEMON__API__HTTPS_TERMINATED_UPSTREAM=false

# Refuse to boot without ENDPOINT_ADMIN_PASSWORD + ENDPOINT_SESSION_SECRET.
# Setting false is for sandbox runs only; never disable in prod.
ENDPOINT_DAEMON__API__REQUIRE_AUTH_ENV=true

# Hard cap on HTTP request body size (bytes). 1 MiB covers any
# legitimate overlay/payload; bigger is either a bug or an attacker.
ENDPOINT_DAEMON__API__MAX_REQUEST_BYTES=1048576

# Per-source-IP token-bucket on POST /v1/auth/login.
ENDPOINT_DAEMON__API__LOGIN_RATE_LIMIT_PER_MINUTE=10

# TTL for cached Idempotency-Key responses (seconds). 24h matches AWS /
# Stripe / Twilio. 0 disables the cache entirely.
ENDPOINT_DAEMON__API__IDEMPOTENCY_TTL_SECONDS=86400

# Hard cap on every destructive-action handler (seconds). 30s is generous
# for the slowest in-process action; longer should run as a background job.
ENDPOINT_DAEMON__API__ACTION_TIMEOUT_SECONDS=30

# Refuse new force_sync_requests inserts past this depth. Caps a runaway
# operator script that loops force-sync over a million users.
ENDPOINT_DAEMON__API__MAX_FORCE_SYNC_QUEUE_DEPTH=10000


# =============================================================================
# Optional — daemon observability (DaemonConfig.observability)
# =============================================================================

# Persist every structlog record into the logs SQLite table. Disable on
# extremely log-heavy deployments where the table outpaces retention.
ENDPOINT_DAEMON__OBSERVABILITY__LOG_TO_SQLITE=true
ENDPOINT_DAEMON__OBSERVABILITY__RETENTION_DAYS=30
ENDPOINT_DAEMON__OBSERVABILITY__RETENTION_INTERVAL_SECONDS=3600
ENDPOINT_DAEMON__OBSERVABILITY__ALERT_TICK_SECONDS=30

# Slice 13: hourly online-safe SQLite backup of state.db. Default 24
# snapshots = 24h of point-in-time recovery.
ENDPOINT_DAEMON__OBSERVABILITY__BACKUP_ENABLED=true
ENDPOINT_DAEMON__OBSERVABILITY__BACKUP_INTERVAL_SECONDS=3600
ENDPOINT_DAEMON__OBSERVABILITY__BACKUP_RETENTION_COUNT=24

# Empty = backups land alongside the live DB. Override to a separate
# disk in prod (e.g. /var/backups).
# ENDPOINT_DAEMON__OBSERVABILITY__BACKUP_DIR=


# =============================================================================
# Optional — daemon alerts (DaemonConfig.alerts)
# =============================================================================

# Slice 13: external webhook for alert delivery. Empty = NullAlertNotifier.
# Must be a fully-qualified URL when set.
ENDPOINT_DAEMON__ALERTS__WEBHOOK_URL=

# Sent as `Authorization: Bearer <token>` when non-empty.
ENDPOINT_DAEMON__ALERTS__WEBHOOK_TOKEN=

# Payload shape: "webhook" (generic JSON) or "slack" ({"text": "..."}).
ENDPOINT_DAEMON__ALERTS__NOTIFIER_FORMAT=webhook

# Idempotently seed the default alert rules on first boot.
ENDPOINT_DAEMON__ALERTS__SEED_DEFAULT_RULES=true


# =============================================================================
# Optional — daemon lifecycle (DaemonConfig.lifecycle)
# =============================================================================

# Slice 12: TTL prune retention (days). 0 disables that prune entirely.
ENDPOINT_DAEMON__LIFECYCLE__SYNC_HISTORY_RETENTION_DAYS=30
ENDPOINT_DAEMON__LIFECYCLE__DEAD_LETTER_RETENTION_DAYS=90
ENDPOINT_DAEMON__LIFECYCLE__AUDIT_LOG_RETENTION_DAYS=365
ENDPOINT_DAEMON__LIFECYCLE__INTERVAL_SECONDS=3600


# =============================================================================
# Optional — daemon ops (DaemonConfig.ops)
# =============================================================================

# Suppress content writes through PostgresContentSink. Used to dry-run
# a full fetch cycle without producing visible content.
ENDPOINT_DAEMON__OPS__SHADOW_MODE=false


# =============================================================================
# Optional — daemon Sentry / GlitchTip (DaemonConfig.sentry)
# =============================================================================
# DSN is deterministic, pinned to the bootstrap-created project key below,
# so it works out of the box after `docker compose --profile observability up`.
# PUBLIC_URL is the human-facing base the dashboard links out to.
ENDPOINT_DAEMON__SENTRY__DSN=http://00000000000040008000000000000001@localhost:8011/1
ENDPOINT_DAEMON__SENTRY__PUBLIC_URL=http://localhost:8011
ENDPOINT_DAEMON__SENTRY__ENVIRONMENT=development
ENDPOINT_DAEMON__SENTRY__ORG_SLUG=endpoint-local
ENDPOINT_DAEMON__SENTRY__TRACES_SAMPLE_RATE=0.0


# =============================================================================
# Presentation API (Django/DRF, src/backend/presentation-api)
# =============================================================================
# Compose maps these onto the unprefixed names Django reads inside the
# container (SECRET_KEY, ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, etc.), so
# the root .env stays namespaced.

PRESENTATION_API_DEBUG=False
PRESENTATION_API_ALLOWED_HOSTS=localhost,127.0.0.1,presentation-api
PRESENTATION_API_CORS_ALLOWED_ORIGINS=http://localhost:3000
PRESENTATION_API_SESSION_TTL_HOURS=24
PRESENTATION_API_MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0


# =============================================================================
# Optional — processor LLM (only if you run the processor pipeline)
# =============================================================================
ENDPOINT_LLM_BASE_URL=https://api.openai.com/v1
ENDPOINT_LLM_API_KEY=your_api_key
ENDPOINT_LLM_MODEL=gpt-5-nano
ENDPOINT_LLM_TIMEOUT_SECONDS=90

# LangSmith tracing for processor LLM calls (optional).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_api_key
LANGSMITH_PROJECT=endpoint


# =============================================================================
# GlitchTip self-host (`--profile observability`)
# =============================================================================
# Dev-only stack. Profile-gated so a bare `docker compose up` doesn't pull
# the GlitchTip images. The bootstrap service creates an admin user, org,
# and project with deterministic public_keys so the DSNs above stay valid
# across `docker compose down -v`. Change SECRET_KEY + ADMIN_PASSWORD for
# any deployment intended to outlive a single-developer dev session.
GLITCHTIP_SECRET_KEY=
GLITCHTIP_PORT=8011
GLITCHTIP_DOMAIN=http://localhost:8011
GLITCHTIP_BOOTSTRAP_ADMIN_EMAIL=admin@endpoint.dev
GLITCHTIP_BOOTSTRAP_ADMIN_PASSWORD=
GLITCHTIP_BOOTSTRAP_ORG_NAME=endpoint-local
GLITCHTIP_BOOTSTRAP_ORG_SLUG=endpoint-local
GLITCHTIP_BOOTSTRAP_PROJECT_NAME=endpoint-ingestion
GLITCHTIP_BOOTSTRAP_PROJECT_SLUG=endpoint-ingestion
GLITCHTIP_BOOTSTRAP_PROJECT_PUBLIC_KEY=00000000-0000-4000-8000-000000000001

# Frontend GlitchTip project. Bootstrap creates this as project_id=2
# (chained off the ingestion bootstrap so the id is deterministic).
GLITCHTIP_BOOTSTRAP_FRONTEND_NAME=endpoint-frontend
GLITCHTIP_BOOTSTRAP_FRONTEND_SLUG=endpoint-frontend
GLITCHTIP_BOOTSTRAP_FRONTEND_PUBLIC_KEY=00000000-0000-4000-8000-000000000002

# Presentation-api GlitchTip project. Bootstrapped as project_id=3.
GLITCHTIP_BOOTSTRAP_PRESENTATION_API_NAME=endpoint-presentation-api
GLITCHTIP_BOOTSTRAP_PRESENTATION_API_SLUG=endpoint-presentation-api
GLITCHTIP_BOOTSTRAP_PRESENTATION_API_PUBLIC_KEY=00000000-0000-4000-8000-000000000003


# =============================================================================
# Sentry SDK / GlitchTip wiring (frontend + presentation-api)
# =============================================================================
# Frontend (@sentry/nextjs). NEXT_PUBLIC_ vars get baked into the browser
# bundle, so the DSN must be reachable from the user's browser. For local
# dev that's the same localhost:8011 GlitchTip is bound to.
NEXT_PUBLIC_SENTRY_DSN=http://00000000000040008000000000000002@localhost:8011/2
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Source-map upload at build time. Leave SENTRY_AUTH_TOKEN empty in dev
# to skip upload; set it in CI/prod with a token from GlitchTip's UI
# under Settings -> Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=endpoint-local
SENTRY_PROJECT=endpoint-frontend
SENTRY_URL=http://localhost:8011/

# Presentation-api Django (sentry-sdk[django]). Lands on project_id=3.
PRESENTATION_API_SENTRY_DSN=http://00000000000040008000000000000003@localhost:8011/3
PRESENTATION_API_SENTRY_ENVIRONMENT=development
# Optional override; defaults to 1.0 in DEBUG, 0.1 in production.
PRESENTATION_API_SENTRY_TRACES_SAMPLE_RATE=


# =============================================================================
# PostHog self-host (`--profile analytics`)
# =============================================================================
# Dev-only stack. Profile-gated so the PostHog images aren't pulled by a
# bare `docker compose up`. The posthog-bootstrap service creates a fixed
# admin + org + team with a deterministic project API token so the
# NEXT_PUBLIC_POSTHOG_KEY below is valid out of the box, no UI clicks.
# Change SECRET_KEY + ADMIN_PASSWORD + database passwords for any
# deployment that outlives a single-developer dev session.
#
# Web UI: http://localhost:8010 (sign in with the admin email/password
# below; the dashboard lands on the bootstrapped project).
POSTHOG_PORT=8010
POSTHOG_SITE_URL=http://localhost:8010
POSTHOG_SECRET_KEY=
POSTHOG_POSTGRES_PASSWORD=
POSTHOG_CLICKHOUSE_PASSWORD=

POSTHOG_BOOTSTRAP_ADMIN_EMAIL=admin@endpoint.dev
POSTHOG_BOOTSTRAP_ADMIN_PASSWORD=
POSTHOG_BOOTSTRAP_ORG_NAME=Endpoint
POSTHOG_BOOTSTRAP_PROJECT_NAME=endpoint-frontend
POSTHOG_BOOTSTRAP_PROJECT_API_TOKEN=phc_endpointlocaldev0000000000000000000000

# Frontend client config — picked up by features/analytics/client.ts.
# Empty NEXT_PUBLIC_POSTHOG_KEY disables analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=phc_endpointlocaldev0000000000000000000000
NEXT_PUBLIC_POSTHOG_HOST=http://localhost:8010
