# syntax=docker/dockerfile:1.6
#
# Build context is the repo root. Copies both src/common/db_core and
# src/processor so uv can resolve the db-core editable path dep declared
# in src/processor/pyproject.toml.
#
#   docker build -f docker/Dockerfile.processor -t endpoint/processor .
#   docker compose up processor

ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app

COPY src/common/db_core/pyproject.toml /app/src/common/db_core/pyproject.toml
COPY src/processor/pyproject.toml      /app/src/processor/pyproject.toml
COPY src/processor/uv.lock             /app/src/processor/uv.lock

COPY src/common/db_core /app/src/common/db_core
COPY src/processor      /app/src/processor

WORKDIR /app/src/processor

RUN uv sync --frozen --no-dev

ENV PATH="/app/src/processor/.venv/bin:${PATH}"

ENTRYPOINT ["tini", "--"]
CMD ["python", "-m", "main"]
